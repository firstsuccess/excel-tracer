  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/office-js": "1.0.552",
    "office-addin-manifest": "^3.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
